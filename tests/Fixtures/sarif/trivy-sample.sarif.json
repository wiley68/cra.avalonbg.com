{
    "version": "2.1.0",
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "Trivy",
                    "informationUri": "https://github.com/aquasecurity/trivy",
                    "rules": [
                        {
                            "id": "CVE-2026-4242",
                            "name": "lodash prototype pollution",
                            "shortDescription": {
                                "text": "Prototype pollution in lodash"
                            },
                            "fullDescription": {
                                "text": "lodash is vulnerable to prototype pollution via CVE-2026-4242."
                            },
                            "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2026-4242",
                            "properties": {
                                "security-severity": "8.1",
                                "purl": "pkg:npm/lodash@4.17.20"
                            },
                            "defaultConfiguration": {
                                "level": "error"
                            }
                        }
                    ]
                }
            },
            "results": [
                {
                    "ruleId": "CVE-2026-4242",
                    "level": "error",
                    "message": {
                        "text": "Package lodash is affected by CVE-2026-4242"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "package-lock.json"
                                },
                                "region": {
                                    "startLine": 120
                                }
                            }
                        }
                    ],
                    "partialFingerprints": {
                        "primaryLocationLineHash": "abc123def456"
                    },
                    "properties": {
                        "pkgName": "lodash",
                        "purl": "pkg:npm/lodash@4.17.20"
                    }
                }
            ]
        }
    ]
}
