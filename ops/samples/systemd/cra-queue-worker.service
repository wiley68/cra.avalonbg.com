# CRA queue worker — systemd sample (Could 13)
#
# Install (adapt User/paths):
#   sudo cp ops/samples/systemd/cra-queue-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cra-queue-worker.service
#
# After deploy:
#   php artisan queue:restart
#   # or: sudo systemctl restart cra-queue-worker.service

[Unit]
Description=CRA Compliance Workspace queue worker
After=network.target
# Uncomment if MySQL/PostgreSQL is on the same host:
# After=network.target mysql.service
# Requires=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cra.avalonbg.com
ExecStart=/usr/bin/php /var/www/cra.avalonbg.com/artisan queue:work --sleep=1 --tries=3 --timeout=90 --max-time=3600
Restart=always
RestartSec=3
# Allow graceful stop past job $timeout (90)
TimeoutStopSec=95

# Harden lightly (optional)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
