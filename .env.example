APP_NAME="Avalon CRA Compliance Workspace"
APP_ENV=local
APP_VERSION=1.0.0
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# База данни (database)
# =============================================================================
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Scheduled VCS/integration sync uses dispatch() — do not use "sync" in staging/prod.
# Also run: cron (* * * * * php artisan schedule:run) + php artisan queue:work
# Or use sample units: ops/samples/ (Supervisor / systemd / Compose) — see documents/Phase2_E_Ops_Baseline.md
# Verify: php artisan ops:baseline-check
QUEUE_CONNECTION=database
# Must be greater than SyncProduct*Job::$timeout (90). Default 150.
# DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# Поща (SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
AGENT_EMAIL_DELIVERY=sync

# Customer patch-campaign email stub (uses MAIL_* mailer; provider credentials later)
CRA_CUSTOMER_NOTIFICATIONS_ENABLED=true

# Auditor review-package share email stub (uses MAIL_* mailer; provider credentials later)
CRA_AUDITOR_NOTIFICATIONS_ENABLED=true

# Auditor guest magic-link TTL (days) for external review without an org user
CRA_AUDITOR_GUEST_LINK_TTL_DAYS=7

# AI assistant — see documents/Phase2_E_Live_LLM_Enablement.md (Phase 2_E Must 3)
# CI/tests force stub via phpunit.xml. Staging/prod live: openai|anthropic + API key.
# Verify (no external call): php artisan ops:ai-check
# Opt-in live smoke: CRA_AI_LIVE_TEST=true + key → php artisan test --group=live-ai
CRA_AI_ENABLED=true
CRA_AI_PROVIDER=stub
# CRA_AI_CONTEXT_MAX_CHARS=8000
# CRA_AI_CONTEXT_REQUIREMENTS_LIMIT=40
# CRA_AI_CONTEXT_CONTROLS_LIMIT=40
# CRA_AI_CONTEXT_EXCERPT_CHARS=400
# CRA_AI_ANALYSE_MAX_CHARS=20000
# CRA_AI_ANALYSE_MAX_UPLOAD_KB=2048
# CRA_AI_RAG_ENABLED=true
# CRA_AI_RAG_TOP_K=6
# Scheduled RAG reindex: off | daily | hourly (needs schedule:run + queue:work)
# CRA_AI_RAG_REINDEX_SCHEDULE=daily
# CRA_AI_RAG_REINDEX_AT=02:30
# Manual: php artisan ai:index-embeddings [--sync] [product] [--organization=]
# CRA_AI_EMBEDDING_PROVIDER=stub
# CRA_AI_EMBEDDING_DIMENSIONS=64
# CRA_AI_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# CRA_AI_QUEUE_ENABLED=true
# CRA_AI_QUEUE_TIMEOUT=120
# CRA_AI_OPENAI_API_KEY=
# CRA_AI_OPENAI_MODEL=gpt-4o-mini
# CRA_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# CRA_AI_OPENAI_TIMEOUT=60
# CRA_AI_ANTHROPIC_API_KEY=
# CRA_AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# CRA_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CRA_AI_ANTHROPIC_TIMEOUT=60
# CRA_AI_LIVE_TEST=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Encrypted exports (7z)
# =============================================================================
SEVEN_ZIP_BINARY=7z
EXPORT_PASSWORD_MIN_LENGTH=8

# =============================================================================
# Audit log retention
# =============================================================================
AUDIT_LOG_RETENTION_YEARS=1
